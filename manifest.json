{
  "manifest_version": 3,
  "name": "Cornucopia",
  "version": "0.1.0",
  "description": "Inspect type, pick colors, measure, resize the viewport, and clear this site's cache. Local only.",
  "homepage_url": "https://github.com/tgalizia/cornucopia",
  "minimum_chrome_version": "102",
  "host_permissions": ["https://docs.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["docs-annotate.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Cornucopia",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "windows"],
  "optional_permissions": ["browsingData"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
